NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:5173
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@example.com

# Optional — Google OAuth for "Connected services" in settings.
# When both GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET are set, Connect Google
# redirects through real OAuth. When missing, the API uses an honest stub that
# marks the account connected without talking to Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
# Land here after OAuth (defaults to CORS_ORIGIN/settings/profile):
# GOOGLE_FRONTEND_REDIRECT=http://localhost:5173/settings/profile

# Optional — richer posters/plots/gallery for IMDb movie import/enrich
# Without keys: covers via IMDb suggestion JSON; plots via Wikipedia title match.
# Gallery (MediaPhoto backdrops) requires TMDB_API_KEY.
# OMDB_API_KEY=
# TMDB_API_KEY=
# Optional enrich flags: IMDB_ENRICH_OPENSEARCH=1  IMDB_ENRICH_WIKIDATA=1
#   bun run import:imdb-movies
#   bun run import:imdb-movie-covers -- --strip-only
#   bun run import:imdb-movie-covers -- --covers-only
#   bun run import:imdb-movie-covers -- --plots-only
#   bun run import:imdb-movie-covers
